{
 "pregunta": "PI-B02",
 "operacion": "Q7",
 "descripcion": "Máximo de correos al mes con 50 USD: cuota expandida por presupuesto (/quotas con max_budget) y capacidad al mes con esa cuota, planes calculables",
 "api": "resend",
 "llamadas": [
  {
   "endpoint": "POST /quotas",
   "params": {
    "capacity_unit": "emails",
    "max_budget": 50
   },
   "body": {
    "endpoint_path": "/emails",
    "plan_names": [
     "free",
     "pro",
     "scale"
    ]
   },
   "datasheet": "03_datos/apis/resend/datasheet.yaml",
   "http": 200,
   "ms": 22,
   "respuesta": {
    "results": {
     "free": [
      {
       "endpoint": "/emails",
       "quotas": [
        {
         "value": 3000.0,
         "unit": "emails",
         "period": "30day"
        },
        {
         "value": 100.0,
         "unit": "emails",
         "period": "1day"
        }
       ]
      }
     ],
     "pro": [
      {
       "endpoint": "/emails",
       "quotas": [
        {
         "value": 50000.0,
         "unit": "emails",
         "period": "30day",
         "overage_cost": {
          "price": 0.0009,
          "value": 1.0
         }
        }
       ]
      }
     ],
     "scale": [
      {
       "endpoint": "/emails",
       "quotas": [
        {
         "value": 100000.0,
         "unit": "emails",
         "period": "30day",
         "overage_cost": {
          "price": 0.0009,
          "value": 1.0
         }
        }
       ]
      }
     ]
    }
   }
  },
  {
   "endpoint": "POST /capacity-at",
   "params": {
    "time": "1month",
    "capacity_unit": "emails",
    "capacity_request_factor": "1",
    "max_budget": 50
