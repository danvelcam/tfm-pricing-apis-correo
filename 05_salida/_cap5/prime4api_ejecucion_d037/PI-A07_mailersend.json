   },
   "body": {
    "endpoint_path": "/v1/email",
    "alias": "healthy_reputation",
    "plan_names": [
     "free"
    ]
   },
   "datasheet": "03_datos/apis/mailersend/datasheet.yaml",
   "http": 200,
   "ms": 62,
   "respuesta": {
    "time": "7day",
    "results": {
     "free": [
      {
       "endpoint": "/v1/email",
       "alias": "healthy_reputation",
       "dimensions": {
        "emails": [
         {
          "capacity_request_factor": 1.0,
          "value": 500.0
         }
        ]
       }
      }
     ]
    }
   }
  }
 ]
}